<Window x:Class="UnlockCat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnlockCat" Icon="Assets/angry-cat.ico" Width="1020" Height="740" MinWidth="780" MinHeight="610"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="130" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
      <Image Source="Assets/angry-cat.png" Width="56" Height="56" Margin="0,0,13,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="UnlockCat" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="파일 · 이동식 디스크 · 포트를 점유한 프로세스 찾기" Foreground="{StaticResource MutedBrush}" FontSize="13" />
      </StackPanel>
    </StackPanel>

    <TabControl x:Name="TargetTabs" Grid.Row="1" Height="116" SelectionChanged="TargetTabs_SelectionChanged">
      <TabItem Header="파일·폴더">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="파일 또는 폴더의 전체 경로" Margin="0,0,0,5" />
            <TextBox x:Name="FilePathBox" />
          </StackPanel>
          <Button Grid.Column="1" Content="파일 선택" Margin="10,20,0,0" Click="BrowseFile_Click" />
          <Button Grid.Column="2" Content="폴더 선택" Margin="8,20,0,0" Click="BrowseFolder_Click" />
        </Grid>
      </TabItem>
      <TabItem Header="이동식 디스크">
        <StackPanel Margin="12">
          <TextBlock Text="검사할 드라이브 (USB 외장 디스크가 고정식으로 표시되어도 선택 가능)" Margin="0,0,0,5" />
          <ComboBox x:Name="VolumeBox" IsEditable="True" DisplayMemberPath="Display" Width="400" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>
      <TabItem Header="포트">
        <StackPanel Margin="12">
          <TextBlock Text="주소:포트 또는 포트 번호 (예: localhost:5000, 5000, [::1]:5000)" Margin="0,0,0,5" />
          <TextBox x:Name="PortBox" Width="400" HorizontalAlignment="Left" Text="localhost:5000" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="0,16,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="ScanButton" Grid.Column="0" Content="점유 프로세스 검색" Background="#DFF1E9" Foreground="#0E543E" BorderBrush="#88B8A3" Click="Scan_Click" />
      <Button x:Name="StopServiceButton" Grid.Column="1" Content="서비스 중지" Click="StopServices_Click" IsEnabled="False" />
      <Button x:Name="KillSelectedButton" Grid.Column="2" Content="선택 프로세스 강제 종료" Click="KillSelected_Click" IsEnabled="False" />
      <Button x:Name="KillAllButton" Grid.Column="3" Content="모두 강제 종료" Click="KillAll_Click" IsEnabled="False" />
      <TextBlock x:Name="StatusText" Grid.Column="4" Text="대상을 선택하고 검색하세요." TextAlignment="Right"
                 VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
    </Grid>

    <DataGrid x:Name="ResultsGrid" Grid.Row="3" AutoGenerateColumns="False" SelectionMode="Extended"
              IsReadOnly="True" CanUserAddRows="False" SelectionChanged="ResultsGrid_SelectionChanged"
              Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" RowBackground="#FFFFFF"
              AlternatingRowBackground="#F6F9FA" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              BorderBrush="{StaticResource BorderBrush}" HorizontalGridLinesBrush="#E3E9ED"
              VerticalGridLinesBrush="#E3E9ED" Margin="0,0,0,12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75" />
        <DataGridTextColumn Header="프로세스" Binding="{Binding ProcessName}" Width="125" />
        <DataGridTextColumn Header="서비스" Binding="{Binding ServiceNames}" Width="175" />
        <DataGridTextColumn Header="실행 파일" Binding="{Binding ImagePath}" Width="200" />
        <DataGridTextColumn Header="점유 근거" Binding="{Binding Summary}" Width="*" />
        <DataGridTextColumn Header="상태" Binding="{Binding ProcessStatus}" Width="125" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <GroupBox Header="선택 항목의 점유 리소스" Margin="0,0,6,0">
        <TextBox x:Name="EvidenceBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" MinHeight="0" />
      </GroupBox>
      <GroupBox Grid.Column="1" Header="검색 및 종료 기록" Margin="6,0,0,0">
        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" MinHeight="0" />
      </GroupBox>
    </Grid>

    <TextBlock Grid.Row="5" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"
               Text="관리자 권한으로 실행됩니다. 공유 서비스 호스트의 서비스는 별도로 선택해 중지할 수 있습니다. 종료 후 자동으로 다시 검색합니다." />
  </Grid>
</Window>
